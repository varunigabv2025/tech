# TrustFlow Backend Environment Variables Example

# Server Port
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=development

# Secret key for JWT signing (Replace with a long, random secret in production)
JWT_SECRET=trustflow_jwt_secret_key_2026_secure_demo
JWT_EXPIRES_IN=7d

# Cookie Security Settings
# In production, COOKIE_SECURE must be true (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS Allowed Origins
CLIENT_URL=http://localhost:3000
FINANCIER_URL=http://localhost:3001
